FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_RETRIES=10 \
    PIP_TIMEOUT=300 \
    PIP_DEFAULT_TIMEOUT=300 \
    ABSA_ROOT_DIR=/app \
    ABSA_ENGINE_ONLY=v14 \
    ABSA_SERVICE_NAME="V14 ABSA API" \
    ABSA_SERVICE_VERSION="14.0.0-candidate" \
    ABSA_MODEL_LOADING=stream

WORKDIR /app/backend

# retry helper: try up to 5 times with 15s backoff
SHELL ["/bin/sh", "-c"]

# Layer 1: torch CPU (~196 MB)
RUN for i in 1 2 3 4 5; do \
      echo "==> Attempt $i: torch" && \
      pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu && break || \
      echo "==> Failed, retrying in 15s..." && sleep 15; \
    done && python -c "import torch; print(torch.__version__)"

# Layer 2: transformers + accelerate
RUN for i in 1 2 3 4 5; do \
      echo "==> Attempt $i: transformers+accelerate" && \
      pip install --no-cache-dir 'transformers>=4.40.0,<5.0.0' 'accelerate>=0.28.0,<1.0.0' && break || \
      echo "==> Failed, retrying in 15s..." && sleep 15; \
    done && python -c "import transformers; print(transformers.__version__)"

# Layer 3: scikit-learn + pandas + numpy
RUN for i in 1 2 3 4 5; do \
      echo "==> Attempt $i: data science packages" && \
      pip install --no-cache-dir 'scikit-learn>=1.2.0,<2.0.0' 'pandas>=2.0.0,<3.0.0' 'numpy>=1.24.0,<2.0.0' && break || \
      echo "==> Failed, retrying in 15s..." && sleep 15; \
    done

# Layer 4: remaining requirements (mostly small packages, already-installed ones are skipped)
COPY backend/requirements.txt /app/requirements.txt
RUN for i in 1 2 3 4 5; do \
      echo "==> Attempt $i: requirements.txt" && \
      pip install --no-cache-dir -r /app/requirements.txt && break || \
      echo "==> Failed, retrying in 15s..." && sleep 15; \
    done

COPY backend /app/backend
COPY absa_v14_context_hardened_seed_42 /app/absa_v14_context_hardened_seed_42

RUN useradd --create-home --uid 10001 absa \
    && mkdir -p /app/storage \
    && chown -R absa:absa /app/storage

USER absa

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--proxy-headers", "--forwarded-allow-ips=*"]
